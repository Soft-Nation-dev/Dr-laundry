{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "${CONNECTION_STRING}"
    //"Redis": "${REDIS_CONNECTION}"
  },

  "AdminSeed": {
    "Email": "${ADMIN_EMAIL}",
    "Password": "${ADMIN_PASSWORD}"
  },

  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "DurationInHours": 2
  },

  "EmailSettings": {
    "FromEmail": "${EMAIL_FROM}",
    "SmtpServer": "${SMTP_SERVER}",
    "SmtpPort": "${SMTP_PORT}",
    "SmtpUser": "${SMTP_USER}",
    "SmtpPass": "${SMTP_PASS}",
    "FromName": "${EMAIL_FROM_NAME}"
  }
}
