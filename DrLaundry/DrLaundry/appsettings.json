{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};Ssl Mode=Require;Trust Server Certificate=true"
  },

  "AdminSeed": {
    "Email": "${ADMIN_EMAIL}",
    "Password": "${ADMIN_PASSWORD}"
  },

  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "LaundryApi",
    "Audience": "LaundryApiUsers",
    "DurationInMinutes": 60
  },

  "EmailSettings": {
    "FromEmail": "${EMAIL_FROM}",
    "SmtpServer": "${SMTP_SERVER}",
    "SmtpPort": "${SMTP_PORT}",
    "SmtpUser": "${SMTP_USER}",
    "SmtpPass": "${SMTP_PASS}",
    "FromName": "Dr Laundry"
  }
}
