{
  "$schema": "../backend/node_modules/wrangler/config-schema.json",
  "name": "dr-laundry-site",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "drlaundry.com.ng/*",
      "zone_name": "drlaundry.com.ng"
    },
    {
      "pattern": "www.drlaundry.com.ng/*",
      "zone_name": "drlaundry.com.ng"
    },
    {
      "pattern": "help.drlaundry.com.ng",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
