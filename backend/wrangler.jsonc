{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dr-laundry-backend",
  "account_id": "d8f8ba0cf7da5e452ac8730b7dfcf231",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "PROFILE_IMAGES",
      "bucket_name": "dr-laundry-profile-images"
    }
  ]
}
